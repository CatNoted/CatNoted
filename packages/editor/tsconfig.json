{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "src",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@catnoted/shared": ["../shared/dist/index.d.ts"],
      "@catnoted/agent-runtime": ["../agent-runtime/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
